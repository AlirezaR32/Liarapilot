# LiaraPilot — environment
# Commercial model: NO service tokens here. GitHub/GitLab/Liara/AI tokens are
# entered by each user in the app (Settings) and stored AES-256-GCM encrypted.

# SQLite location. On Liara the entrypoint already defaults this to the
# mounted disk: file:/app/data/liarapilot.db  (this file is optional)
# DATABASE_URL=file:/app/data/liarapilot.db

# Optional: fixed encryption key for credential storage. If unset, a random
# 256-bit key is auto-generated once and persisted on the data disk
# (liarapilot.secret.key next to the DB file).
# LIARAPILOT_SECRET=

# Optional: GitHub webhook HMAC secret (only if you configure a webhook).
# GITHUB_WEBHOOK_SECRET=
